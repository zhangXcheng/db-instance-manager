# ---------- Django ----------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- 数据库 ----------
# sqlite（默认，零配置可跑） | mysql
DB_ENGINE=sqlite
DB_NAME=db_instance_manager
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------- Celery ----------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# 本地没有 Redis 时设为 1，任务会在当前进程同步执行（便于自测）
CELERY_TASK_ALWAYS_EAGER=0

# ---------- 凭据加密 ----------
# 逗号分隔，第一个用于加密，其余用于解密（支持密钥轮换）。
# 生产环境务必从 KMS / 密钥管理服务注入，禁止入库入仓。
FERNET_SECRETS=dev-only-secret-please-replace-me

# ---------- 密码轮换 ----------
CREDENTIAL_ROTATION_INTERVAL_HOURS=12
CREDENTIAL_PASSWORD_LENGTH=24
# 演示用模拟驱动；接入真实数据库改为 inventory.services.drivers.MySQLDriver
CREDENTIAL_DRIVER=inventory.services.drivers.SimulatedDriver

# ---------- TCP 探测 ----------
TCP_PROBE_TIMEOUT=3
TCP_PROBE_MAX_WORKERS=8
